# Run inside Linux containers and on the VM, so every clone checks them out with LF, Windows ones included
# (core.autocrlf would otherwise leave mvnw unrunnable in a Docker build: /bin/sh: ./mvnw: not found).
/mvnw text eol=lf
*.sh text eol=lf
routing-service/src/test/resources/fixture-roads.osm text eol=lf
infra/summarize-booking-acceptance.py text eol=lf
/infra/map-import/prepare.sh text eol=lf
/.mvn/jvm.config text eol=lf
experiments/datasets/contract-lifecycle.json -text whitespace=cr-at-eol

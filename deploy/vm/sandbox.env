# Settings for the scheduler sandbox (deploy/vm/sandbox.override.yml) on a developer's own machine. None of these
# values is a secret and none may be used on the scheduler VM, whose .env holds generated secrets (.env.example).
# Tenant tokens are never kept here: --command=issue-token prints each one once.

SCHEDULER_DB_OWNER_PASSWORD=sandbox-owner-local-only
SCHEDULER_DB_PASSWORD=sandbox-login-local-only
SCHEDULER_RETENTION_DAYS=7

# The API answers on loopback only: plain HTTP at http://127.0.0.1:18090/api/v1, and HTTPS with a self-signed
# certificate at https://127.0.0.1:18091/api/v1, as the VM will be reached.
SCHEDULER_API_BIND=127.0.0.1
SCHEDULER_API_PORT=18091
SCHEDULER_MANAGEMENT_BIND=127.0.0.1
SCHEDULER_PRIVATE_PORT=18090

# The one metro the sandbox serves, routed by the fixture router.
ROUTING_METRO_URLS=sandbox=http://fixture-routing:8001
ROUTING_AUTH_TOKEN=sandbox-routing-token-local-only-not-a-secret
ACTIVE_MAP_VERSION=fixture

# Smaller than the VM's pools, for a laptop.
SCHEDULER_BOOKING_MEMORY=1g
SCHEDULER_DAILY_MEMORY=1g
SCHEDULER_DB_MEMORY=512m

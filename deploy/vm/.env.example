# Copy to deploy/vm/.env and fill in. Every value without a default is required; Compose refuses to start without it.
# Generate secrets with: openssl rand -base64 48 | tr -d '/+=' | cut -c1-48

# Database owner (migrations and tenant commands) and the scheduler's serving login (16 to 128 of A-Z a-z 0-9 . _ ~ -).
SCHEDULER_DB_OWNER_PASSWORD=
SCHEDULER_DB_PASSWORD=

# Days the thin store keeps requests, proposals, offers and receipts (1 to 3650). No default: the operator decides.
SCHEDULER_RETENTION_DAYS=

# The interface WaterFlex Software reaches (for example 10.0.4.12) and the HTTPS port on it (scheduler-proxy). The
# certificate (fullchain.pem) and key (privkey.pem) are read from SCHEDULER_TLS_DIR, deploy/vm/tls by default.
SCHEDULER_API_BIND=
SCHEDULER_API_PORT=443
#SCHEDULER_TLS_DIR=/etc/scheduler/tls
# The proxy's plain HTTP listener (the API plus the detailed /health) and Prometheus (--profile monitoring) stay on
# loopback unless an internal monitor needs them. Replicas publish no ports.
SCHEDULER_MANAGEMENT_BIND=127.0.0.1
SCHEDULER_PRIVATE_PORT=8000

# One routing service per served metro, using WaterFlex Software metro IDs. Shared bearer token, at least 32 characters.
ROUTING_METRO_URLS=metro-omaha=http://routing-omaha:8001
ROUTING_AUTH_TOKEN=

# The Docker volume holding the copied map versions, and the version to serve.
MAP_VOLUME=scheduler-vm-maps
ACTIVE_MAP_VERSION=

# Optional: COORDINATES_REQUIRED (default) or NOMINATIM (start with --profile nominatim).
GEOCODING_MODE=COORDINATES_REQUIRED

# Compute partition (Compose deploy.resources limits, per replica) within the VM's 8 vCPU: booking 2, daily 2, routing 2,
# Postgres 1, proxy 0.5 and Prometheus 0.5 (infra/test_vm_cpu_budget.py holds the defaults to it). Raising one cap or
# adding a replica means lowering another first. Admission capacity should match each replica's cores. Booking pool:
# latency first; it needs more when booking p95 nears the client's deadline or admission rejects.
SCHEDULER_BOOKING_REPLICAS=1
SCHEDULER_BOOKING_CPUS=2
SCHEDULER_BOOKING_MEMORY=2g
SCHEDULER_BOOKING_SEARCH_CAPACITY=2
# Database connections per booking replica: more than the capacity plus confirm slots, with headroom (capacity + 6 is
# safe). The publish reserve (800 to 1000 ms) is the part of a client's bookingDeadlineMs kept for validating and
# publishing the offers; the request log's commitMs says how much of it searches use.
SCHEDULER_BOOKING_DB_POOL_SIZE=10
SCHEDULER_BOOKING_PUBLISH_RESERVE_MS=1000
# The cap on an optional booking refinement for a client that sets no bookingRefinementMs, 0 to 3000 (2000 since
# 2026-10-20; the booking configuration study found it within $0.79 of uncapped with less deadline pressure than 3000).
SCHEDULER_BOOKING_REFINEMENT_MS=2000
# Daily pool: throughput, and what overnight optimization runs on; it needs more when queued days wait too long
# (scheduler_daily_queue_expired_total rises).
# The background limit is how many daily solves one replica runs at once, at most its search capacity.
SCHEDULER_DAILY_REPLICAS=1
SCHEDULER_DAILY_CPUS=2
SCHEDULER_DAILY_MEMORY=2g
SCHEDULER_DAILY_SEARCH_CAPACITY=2
SCHEDULER_DAILY_BACKGROUND_LIMIT=2
SCHEDULER_DAILY_DB_POOL_SIZE=10
# JVM flags per pool. The default sizes the heap at three quarters of the memory limit and leaves the garbage
# collector at the JDK's choice (G1); research/api-load.md "Confirm priority and JVM settings" records what was measured.
#SCHEDULER_BOOKING_JAVA_OPTIONS=-XX:MaxRAMPercentage=75
#SCHEDULER_DAILY_JAVA_OPTIONS=-XX:MaxRAMPercentage=75
ROUTING_CPUS=2
ROUTING_MEMORY=6g
SCHEDULER_DB_CPUS=1
SCHEDULER_DB_MEMORY=1g
SCHEDULER_PROXY_CPUS=0.5
SCHEDULER_PROXY_MEMORY=128m
PROMETHEUS_CPUS=0.5
PROMETHEUS_MEMORY=512m
# Nominatim (--profile nominatim) has no room in the 8 vCPU above. Once its import has finished, give it some by
# lowering another cap, for example ROUTING_CPUS=1.5 with NOMINATIM_CPUS=0.5.

// Prisma owns all migrations. The Java scheduler reads these tables via JDBC.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Reference / org data
// ---------------------------------------------------------------------------

model Metro {
  id              String   @id @default(cuid())
  name            String
  timezone        String // IANA tz, e.g. "America/Chicago"
  stateCode       String? // two-letter state code for bounded local geocoder extracts
  serviceRadiusMi Float    @default(65) // customer coverage radius from the nearest metro depot
  createdAt       DateTime @default(now())

  depots           Depot[]
  optimizationRuns OptimizationRun[]
  reservationArrangements ReservationArrangement[]
  apiOfferSets     PortalApiOfferSet[]
  apiDailyProposals PortalApiDailyProposal[]

  @@map("metro")
}

model Depot {
  id        String   @id @default(cuid())
  metroId   String
  metro     Metro    @relation(fields: [metroId], references: [id])
  name      String
  lat       Float
  lng       Float
  addressLine1 String?
  addressCity String?
  addressState String?
  addressPostalCode String?
  geocodeLat Float?
  geocodeLng Float?
  geocodePrecision String?
  pinConfirmedAt DateTime?
  createdAt DateTime @default(now())

  dealershipId String
  dealership Dealership @relation(fields: [dealershipId], references: [id])
  endpointPolicies DepotEndpointPolicy[]
  assignments TechnicianDepotAssignment[]

  @@index([dealershipId])

  @@map("depot")
}

enum RouteAnchor {
  HOME
  DEPOT
}

model DepotEndpointPolicy {
  depotId String
  depot Depot @relation(fields: [depotId], references: [id], onDelete: Cascade)
  effectiveDate DateTime
  departure RouteAnchor
  returnTo RouteAnchor

  @@id([depotId, effectiveDate])
  @@map("depot_endpoint_policy")
}

/// A client the portal schedules for, standing in for WaterFlex Software. Its API token is in the environment.
model Client {
  id          String       @id
  name        String
  createdAt   DateTime     @default(now()) @db.Timestamptz(6)
  dealerships Dealership[]
  technicians Technician[]
  customers   Customer[]
  solverSettings ClientSolverSettings?
  apiOfferSets   PortalApiOfferSet[]
  apiDailyProposals PortalApiDailyProposal[]

  @@map("client")
}

// A client's own booking and routing settings. No row means the client has not configured them yet.
model ClientSolverSettings {
  clientId               String   @id
  client                 Client   @relation(fields: [clientId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  regularHourly          Decimal  @db.Decimal(14, 4)
  overtimeHourly         Decimal  @db.Decimal(14, 4)
  mileagePerMile         Decimal  @db.Decimal(14, 4)
  travelBufferPct        Decimal  @db.Decimal(6, 4)
  travelBufferMinutes    Int
  fairnessBudget         Decimal  @db.Decimal(6, 4)
  offerLimit             Int
  bookingHorizonWeekdays Int
  version                Int      @default(0)
  updatedAt              DateTime @default(now()) @db.Timestamptz(6)

  @@map("client_solver_settings")
}

model Dealership {
  id String @id @default(cuid())
  clientId String
  client Client @relation(fields: [clientId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  name String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  depots Depot[]

  @@index([clientId], map: "dealership_client")
  @@map("dealership")
}

model Technician {
  id                 String      @id @default(cuid())
  clientId           String
  client             Client      @relation(fields: [clientId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  name               String
  email              String?
  phone              String?
  bio                String?
  color              String
  homeAddressLine1   String?
  homeAddressCity    String?
  homeAddressState   String?
  homeAddressPostalCode String?
  homeLat            Float
  homeLng            Float
  homePinProvenance  String? // GEOCODER_HOUSE | MANUALLY_CONFIRMED; null for legacy homes
  shiftStartMin      Int // minutes from local midnight, e.g. 480 = 8:00am
  shiftEndMin        Int
  maxDailyMinutes    Int         @default(540)
  maxOvertimeMinutes Int         @default(60)
  active             Boolean     @default(true)
  factsChangedAt     DateTime    @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6) // set by database triggers
  externalId         String?     @unique // integration seam
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  appointments Appointment[]
  slotHolds    SlotHold[]
  scheduleDays ScheduleDay[]
  dayChanges   TechnicianDayChange[]
  qualifications TechnicianQualification[]
  shiftOverrides TechnicianShiftOverride[]
  availabilityVersions TechnicianAvailabilityVersion[]
  timeOffRequests TimeOffRequest[]
  depotAssignments TechnicianDepotAssignment[]
  reservationDependencies ReservationDependency[]

  @@index([active])
  @@index([clientId], map: "technician_client")
  @@map("technician")
}

model TechnicianDepotAssignment {
  technicianId String
  technician Technician @relation(fields: [technicianId], references: [id], onDelete: Cascade)
  effectiveDate DateTime
  depotId String
  depot Depot @relation(fields: [depotId], references: [id])

  @@id([technicianId, effectiveDate])
  @@index([depotId, effectiveDate])
  @@map("technician_depot_assignment")
}

model TechnicianAvailabilityVersion {
  id String @id @default(cuid())
  technicianId String
  technician Technician @relation(fields: [technicianId], references: [id], onDelete: Cascade)
  effectiveDate DateTime
  days TechnicianAvailabilityDay[]

  @@unique([technicianId, effectiveDate])
  @@map("technician_availability_version")
}

model TechnicianAvailabilityDay {
  versionId String
  version TechnicianAvailabilityVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  dayOfWeek Int
  available Boolean
  shiftStartMin Int?
  shiftEndMin Int?

  @@id([versionId, dayOfWeek])
  @@map("technician_availability_day")
}

// ---------------------------------------------------------------------------
// Catalog
// ---------------------------------------------------------------------------

model ServiceCatalog {
  id             String   @id @default(cuid())
  code           String   @unique
  name           String // customer-facing dropdown label
  description    String?
  estDurationMin Int
  bufferPct      Float    @default(0.15) // confidence buffer, e.g. 0.15 = +15%
  startsAtDepot  Boolean  @default(false) // needs parts pickup before first stop
  active         Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  jobs Job[]
  qualifications TechnicianQualification[]

  reservationDependencies ReservationDependency[]

  @@map("service_catalog")
}

// ---------------------------------------------------------------------------
// Customers / jobs / appointments
// ---------------------------------------------------------------------------

model Customer {
  id         String   @id @default(cuid())
  clientId   String
  client     Client   @relation(fields: [clientId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  firstName  String
  lastName   String
  email      String
  phone      String
  externalId String?  @unique
  createdAt  DateTime @default(now())

  addresses Address[]
  jobs      Job[]

  @@index([clientId], map: "customer_client")
  @@map("customer")
}

model Address {
  id               String    @id @default(cuid())
  customerId       String
  customer         Customer  @relation(fields: [customerId], references: [id])
  line1            String
  line2            String?
  city             String
  state            String
  postalCode       String
  lat              Float?
  lng              Float?
  geocodePrecision String? // ROOFTOP | RANGE_INTERPOLATED | GEOMETRIC_CENTER | APPROXIMATE | SYNTHETIC | MANUALLY_CONFIRMED
  geocodedAt       DateTime?
  pinConfirmedAt  DateTime?
  createdAt        DateTime  @default(now())

  jobs Job[]

  @@map("address")
}

enum JobStatus {
  PENDING // slot generation in progress / not yet booked
  SCHEDULED
  COMPLETED
  CANCELLED
}

model Job {
  id               String         @id @default(cuid())
  customerId       String
  customer         Customer       @relation(fields: [customerId], references: [id])
  addressId        String
  address          Address        @relation(fields: [addressId], references: [id])
  serviceId        String
  service          ServiceCatalog @relation(fields: [serviceId], references: [id])
  durationMin      Int // snapshot of service.estDurationMin * (1 + bufferPct) at booking time
  status           JobStatus      @default(PENDING)
  priority         Int            @default(0)
  externalId       String?        @unique
  bookingRequestId String?        @unique // client retry key for the slot-search attempt
  bookingRequestFingerprint String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  appointment          Appointment?
  slotHolds            SlotHold[]
  bookingOptimizations BookingOptimization[]
  bookingOffers BookingOffer[]
  offerSets BookingOfferSet[]
  searchRequests BookingSearchRequest[]
  apiOfferSets   PortalApiOfferSet[]
  manualFollowUpStatus String?
  manualFollowUpReason String?

  @@map("job")
}

model Appointment {
  id           String     @id @default(cuid())
  jobId        String     @unique
  job          Job        @relation(fields: [jobId], references: [id])
  technicianId String
  technician   Technician @relation(fields: [technicianId], references: [id])

  serviceDate DateTime // date-only, stored at midnight UTC of the metro's local day
  windowStart DateTime // customer promise — must not move without contact
  windowEnd   DateTime // customer promise — must not move without contact

  plannedStart DateTime // internal — freely re-orderable by the optimizer
  plannedEnd   DateTime
  sequence     Int // internal position in the technician's route for serviceDate

  externalId String?  @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  cancelledAt DateTime?
  cancellationReason String?

  @@index([technicianId, serviceDate])
  @@map("appointment")
}

// ---------------------------------------------------------------------------
// Booking concurrency
// ---------------------------------------------------------------------------

model ScheduleDay {
  id           String     @id @default(cuid())
  technicianId String
  technician   Technician @relation(fields: [technicianId], references: [id])
  serviceDate  DateTime
  version      Int        @default(0) // bumped on every committed change; the lock row
  routeTiming  Json?      // independently validated current segment timing at the recorded version

  @@unique([technicianId, serviceDate])
  @@map("schedule_day")
}

// When a technician-day's own facts last changed (appointments, date exception, time off). Written only by database
// triggers; no row means never. The public API lastModified is the later of this and technician.factsChangedAt.
model TechnicianDayChange {
  technicianId String
  technician   Technician @relation(fields: [technicianId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  serviceDate  DateTime
  changedAt    DateTime   @db.Timestamptz(6)

  @@id([technicianId, serviceDate])
  @@map("technician_day_change")
}

// Offers the public scheduling API returned for a job, kept by the portal acting as the host.
model PortalApiOfferSet {
  id              String           @id
  clientId        String
  client          Client           @relation(fields: [clientId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  jobId           String
  job             Job              @relation(fields: [jobId], references: [id], onDelete: Cascade)
  metroId         String
  metro           Metro            @relation(fields: [metroId], references: [id], onDelete: Restrict)
  requestId       String           @unique @db.Uuid
  expiresAt       DateTime         @db.Timestamptz(6)
  searchComplete  Boolean
  holdId          String?
  selectedOfferId String?
  selectedOffer   PortalApiOffer?  @relation("SelectedOffer", fields: [selectedOfferId], references: [id], onDelete: Restrict)
  receiptId       String?          @unique
  endedAt         DateTime?        @db.Timestamptz(6)
  createdAt       DateTime         @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)
  offers          PortalApiOffer[] @relation("SetOffers")

  @@index([jobId, createdAt], map: "portal_api_offer_set_job")
  @@map("portal_api_offer_set")
}

model PortalApiOffer {
  id          String              @id
  offerSetId  String
  offerSet    PortalApiOfferSet   @relation("SetOffers", fields: [offerSetId], references: [id], onDelete: Cascade)
  serviceDate DateTime            @db.Date
  windowStart DateTime            @db.Timestamptz(6)
  windowEnd   DateTime            @db.Timestamptz(6)
  selectedBy  PortalApiOfferSet[] @relation("SelectedOffer")

  @@index([offerSetId], map: "portal_api_offer_set_offers")
  @@map("portal_api_offer")
}

model PortalApiDailyProposal {
  id              String    @id
  clientId        String
  client          Client    @relation(fields: [clientId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  metroId         String
  metro           Metro     @relation(fields: [metroId], references: [id], onDelete: Restrict)
  serviceDate     DateTime  @db.Date
  requestId       String    @unique @db.Uuid
  decision        String
  proposal        Json
  technicianDays  Json
  baseline        Json
  commitRequestId String?   @unique @db.Uuid
  receiptId       String?   @unique
  committedAt     DateTime? @db.Timestamptz(6)
  commitRefusal   String?
  createdAt       DateTime  @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)

  @@index([clientId, metroId, serviceDate, createdAt], map: "portal_api_daily_proposal_day")
  @@map("portal_api_daily_proposal")
}

model SlotHold {
  id                    String               @id @default(cuid())
  offerToken            String // groups the 3-4 offers shown together; confirming one releases siblings
  jobId                 String // the job this hold would become an Appointment for, if confirmed
  job                   Job                  @relation(fields: [jobId], references: [id])
  technicianId          String
  technician            Technician           @relation(fields: [technicianId], references: [id])
  serviceDate           DateTime
  windowStart           DateTime // customer-facing promise, copied onto Appointment on confirm
  windowEnd             DateTime
  plannedStart          DateTime // internal arrival estimate at offer time; re-validated on confirm
  plannedEnd            DateTime
  insertPosition        Int // position among the tech's existing stops at offer time; re-validated on confirm
  locationLat           Float? // snapshot used to account for active holds during offer generation
  locationLng           Float?
  expiresAt             DateTime
  releasedAt            DateTime?
  createdAt             DateTime             @default(now())
  bookingOptimizationId String?
  bookingOptimization   BookingOptimization? @relation(fields: [bookingOptimizationId], references: [id])
  offerSetId String?
  offerSet BookingOfferSet? @relation(fields: [offerSetId], references: [id])
  reservationDependencies ReservationDependency[]

  @@index([technicianId, serviceDate])
  @@index([expiresAt])
  @@index([jobId])
  @@index([bookingOptimizationId])
  @@map("slot_hold")
}

model ReservationArrangement {
  id String @id @default(cuid())
  metroId String
  metro Metro @relation(fields: [metroId], references: [id])
  serviceDate DateTime
  version Int @default(0)
  state Json? // null means the lock row has not yet received a validated arrangement
  updatedAt DateTime @updatedAt
  dependencies ReservationDependency[]

  @@unique([metroId, serviceDate])
  @@map("reservation_arrangement")
}

model ReservationDependency {
  arrangementId String
  arrangement ReservationArrangement @relation(fields: [arrangementId], references: [id], onDelete: Cascade)
  holdId String
  hold SlotHold @relation(fields: [holdId], references: [id], onDelete: Cascade)
  technicianId String
  technician Technician @relation(fields: [technicianId], references: [id])
  serviceId String
  service ServiceCatalog @relation(fields: [serviceId], references: [id])
  serviceDate DateTime

  @@id([holdId, technicianId, serviceId])
  @@index([technicianId, serviceDate])
  @@index([arrangementId])
  @@map("reservation_dependency")
}

model BookingOffer {
  costModelVersion String @default("exact-fleet-half-up-v3")
  policyVersion String @default("zero-overtime-four-hour-v2")
  id String @id @default(cuid())
  jobId String
  job Job @relation(fields: [jobId], references: [id])
  serviceDate DateTime
  windowStart DateTime
  windowEnd DateTime
  expiresAt DateTime
  incrementalRegularMinutes Int?
  incrementalOvertimeMinutes Int?
  overtimeAuthorized Boolean @default(false)
  incrementalRoadMeters Int?
  incrementalCostDollars Decimal? @db.Decimal(65, 30)
  createdAt DateTime @default(now())
  offerSetId String?
  offerSet BookingOfferSet? @relation(fields: [offerSetId], references: [id])

  @@index([jobId, expiresAt])
  @@map("booking_offer")
}

model BookingOfferSet {
  costModelVersion String @default("exact-fleet-half-up-v3")
  policyVersion String @default("zero-overtime-four-hour-v2")
  id String @id @default(cuid())
  jobId String
  job Job @relation(fields: [jobId], references: [id])
  expiresAt DateTime
  supersededAt DateTime?
  selectedOfferId String?
  searchDiagnostics Json?
  searchRequests BookingSearchRequest[]
  createdAt DateTime @default(now())
  offers BookingOffer[]
  holds SlotHold[]

  @@index([jobId, expiresAt])
  @@map("booking_offer_set")
}

model TimeOffRequest {
  id String @id @default(cuid())
  technicianId String
  technician Technician @relation(fields: [technicianId], references: [id])
  category String
  reason String
  status String @default("PENDING")
  createdAt DateTime @default(now())
  decidedAt DateTime?
  additionalOvertimeApproved Boolean @default(false)
  intervals TimeOffInterval[]
  report TimeOffReport?

  @@index([technicianId, status])
  @@map("time_off_request")
}

model TimeOffInterval {
  id String @id @default(cuid())
  requestId String
  request TimeOffRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  serviceDate DateTime
  startMin Int
  endMin Int

  @@index([serviceDate])
  @@map("time_off_interval")
}

model TimeOffReport {
  id String @id @default(cuid())
  requestId String @unique
  request TimeOffRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  status String @default("QUEUED")
  progress Int @default(0)
  data Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("time_off_report")
}

model TechnicianQualification {
  technicianId String
  technician Technician @relation(fields: [technicianId], references: [id])
  serviceId String
  service ServiceCatalog @relation(fields: [serviceId], references: [id])

  @@id([technicianId, serviceId])
  @@map("technician_qualification")
}

model TechnicianShiftOverride {
  id String @id @default(cuid())
  technicianId String
  technician Technician @relation(fields: [technicianId], references: [id])
  serviceDate DateTime
  available Boolean @default(true)
  shiftStartMin Int?
  shiftEndMin Int?

  @@unique([technicianId, serviceDate])
  @@map("technician_shift_override")
}

model RoadRouteCache {
  id String @id @default(cuid())
  originKey String
  destinationKey String
  profile String
  mapVersion String
  seconds Int?
  meters Int?
  routable Boolean
  fetchedAt DateTime @default(now())

  @@unique([originKey, destinationKey, profile, mapVersion])
  @@index([fetchedAt])
  @@map("road_route_cache")
}

model OmahaSetting {
  key String @id
  value Decimal @db.Decimal(65, 30)
  updatedAt DateTime @updatedAt

  @@map("omaha_setting")
}

// Immutable numeric migration evidence. Original float bits and decimal rendering are retained.
model MonetaryMigrationReceipt {
  sourceTable String
  sourceIdentity String
  sourceColumn String
  legacyRendering String
  legacyBits String
  decimalValue Decimal @db.Decimal(65, 30)
  costModelVersion String
  migratedAt DateTime @default(now()) @db.Timestamptz(6)

  @@id([sourceTable, sourceIdentity, sourceColumn])
  @@map("monetary_migration_receipt")
}

model BookingOptimization {
  id                   String     @id @default(cuid())
  jobId                String
  job                  Job        @relation(fields: [jobId], references: [id])
  offerToken           String     @unique
  algorithmVersion     String
  strategy             String
  candidateCount       Int
  qualifyingOfferCount Int
  returnedOffers       Json
  solverMs             Int        @default(0)
  fallbackStatus       String?
  travelWarnings       Json
  confirmedHoldId      String?
  createdAt            DateTime   @default(now()) @db.Timestamptz(6)
  slotHolds            SlotHold[]

  @@index([jobId, createdAt])
  @@map("booking_optimization")
}

model OptimizationRun {
  id                   String               @id @default(cuid())
  requestKey           String?              @unique
  metroId              String
  metro                Metro                @relation(fields: [metroId], references: [id])
  serviceDate          DateTime @db.Timestamptz(6)
  scheduleVersions     Json
  weights              Json
  solverStatus         String
  solveMs              Int
  routeSummaryBefore   Json
  routeSummaryAfter    Json
  warnings             Json
  proposedAssignments  Json
  baselineAssignments  Json                 @default("[]")
  endpointSnapshots    Json?
  policyAnalysis       Json?
  objectiveImprovement BigInt
  churnCost            Int
  status               String
  reason               String?
  createdAt            DateTime             @default(now()) @db.Timestamptz(6)
  appliedAt            DateTime? @db.Timestamptz(6)
  changes              OptimizationChange[]

  @@index([metroId, serviceDate, createdAt])
  @@map("optimization_run")
}

/// Client of the public scheduling API (/api/v1).
model Tenant {
  id         String           @id
  name       String
  createdAt  DateTime         @default(now()) @db.Timestamptz(6)
  disabledAt DateTime?        @db.Timestamptz(6)
  tokens     TenantApiToken[]
  apiRequests ApiRequest[]
  bookingDays ApiBookingDay[]
  @@map("tenant")
}

/// Public API token; only its SHA-256 hex digest is stored.
model TenantApiToken {
  id          String    @id
  tenantId    String
  tokenSha256 String    @unique
  label       String
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  revokedAt   DateTime? @db.Timestamptz(6)
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onUpdate: Cascade, onDelete: Restrict)
  @@index([tenantId], map: "tenant_api_token_tenant")
  @@map("tenant_api_token")
}

model OvernightOptimizationAttempt {
  id String @id
  metroId String
  serviceDate DateTime @db.Date
  state String
  previewKey String @unique
  resultRunId String?
  resultReason String?
  failureContext Json?
  startedAt DateTime @default(now()) @db.Timestamptz(6)
  finishedAt DateTime? @db.Timestamptz(6)
  /// Chicago date the overnight run fired; NULL only for rows written before per-night claims.
  nightOf DateTime? @db.Date
  @@unique([metroId, serviceDate, nightOf], map: "overnight_optimization_attempt_night_claim")
  @@index([metroId, serviceDate, startedAt], map: "overnight_optimization_attempt_metro_day")
  @@index([state, startedAt], map: "overnight_optimization_attempt_state_started")
  @@map("overnight_optimization_attempt")
}

model DailyCalculationAttempt {
  id                 String @id
  requestKey         String @unique
  requestFingerprint String
  ownerToken         String
  state              String
  expiresAt          DateTime @db.Timestamptz(6)
  snapshotRevision   String?
  routingIdentity    String?
  resultRunId        String?
  resultJson         Json?
  failureReason      String?
  createdAt          DateTime @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime @default(now()) @db.Timestamptz(6)
  @@index([state, expiresAt], map: "daily_calculation_attempt_state_expiry")
  @@map("daily_calculation_attempt")
}

// Local sequential booking harness. Jobs use stable IDs derived from request IDs.
model BookingTestRun {
  id String @id
  config Json
  horizon Json
  status String @default("PAUSED")
  revision Int @default(0)
  error String?
  purgedAt DateTime?
  purgedCount Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  requests BookingTestRequest[]
  previews BookingTestPreview[]
  generation BookingTestGeneration?
  @@map("booking_test_run")
}

model BookingTestGeneration {
  runId String @id
  run BookingTestRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  acceptedInputs Json @default("[]")
  randomState BigInt
  roundRobinCursor Int @default(0)
  pendingCandidates Json?
  candidatesTried BigInt @default(0)
  batches BigInt @default(0)
  elapsedMs BigInt @default(0)
  consecutiveNoProgressBatches BigInt @default(0)
  completedAt DateTime?
  @@map("booking_test_generation")
}

model BookingTestRequest {
  id String @id
  runId String
  run BookingTestRun @relation(fields: [runId], references: [id])
  ordinal Int
  input Json
  status String @default("PENDING")
  offers Json @default("[]")
  selected Json?
  attempts Json @default("[]")
  appointmentId String?
  serviceDate String?
  error String?
  elapsedMs Int @default(0)
  startedAt DateTime?
  completedAt DateTime?
  @@unique([runId, ordinal])
  @@map("booking_test_request")
}

model BookingTestPreview {
  id String @id
  runId String
  run BookingTestRun @relation(fields: [runId], references: [id])
  serviceDate String
  optimizationId String?
  result Json?
  error String?
  @@unique([runId, serviceDate])
  @@map("booking_test_preview")
}

model OptimizationChange {
  id                    String          @id @default(cuid())
  runId                 String
  run                   OptimizationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  appointmentId         String
  fromTechnicianId      String
  toTechnicianId        String
  fromSequence          Int
  toSequence            Int
  fromPlannedArrivalMin Int
  toPlannedArrivalMin   Int

  @@index([runId])
  @@map("optimization_change")
}

// ---------------------------------------------------------------------------
// Travel time cache
// ---------------------------------------------------------------------------

enum TimeBucket {
  AM_PEAK
  MIDDAY
  PM_PEAK
}

enum DayType {
  WEEKDAY
  WEEKEND
}

model TravelTime {
  id            String     @id @default(cuid())
  originGeohash String // geohash precision 7 (~150m cells)
  destGeohash   String
  timeBucket    TimeBucket
  dayType       DayType
  seconds       Int
  meters        Int
  source        String     @default("google_distance_matrix") // or "haversine_fallback"
  fetchedAt     DateTime   @default(now())

  @@unique([originGeohash, destGeohash, timeBucket, dayType])
  @@index([fetchedAt])
  @@map("travel_time")
}

// ---------------------------------------------------------------------------
// Scoring config (ops-tunable, no deploy required)
// ---------------------------------------------------------------------------

model ScoringWeight {
  id        String   @id @default(cuid())
  key       String   @unique // "w_drive" | "w_days" | "w_util" | "w_window"
  value     Float
  updatedAt DateTime @updatedAt

  @@map("scoring_weight")
}

// ---------------------------------------------------------------------------
// Integration seam
// ---------------------------------------------------------------------------

model OutboundEvent {
  id          String    @id @default(cuid())
  aggregate   String // "job" | "appointment" | "customer" | "technician"
  aggregateId String
  eventType   String // "created" | "updated" | "cancelled"
  payload     Json
  createdAt   DateTime  @default(now())
  deliveredAt DateTime?

  @@index([deliveredAt])
  @@map("outbound_event")
}

model BookingSearchRequest {
  bestCostDeltaCents BigInt?
  state String?
  refresh Boolean @default(false)
  owner String?
  leaseUntil DateTime?
  startedAt DateTime?
  finishedAt DateTime?
  stopReason String?
  queueMs BigInt?
  completedWork BigInt @default(0)
  phase String @default("QUEUED")
  id String @id
  jobId String
  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)
  deadlineAt DateTime
  cancelledAt DateTime?
  acknowledgedAt DateTime?
  offerSetId String?
  offerSet BookingOfferSet? @relation(fields: [offerSetId], references: [id], onDelete: SetNull)
  cleanedAt DateTime?
  createdAt DateTime @default(now())

  @@index([cancelledAt, cleanedAt], map: "booking_search_request_cleanup_idx")
  @@index([deadlineAt], map: "booking_search_request_deadline_idx")
  @@map("booking_search_request")
}

/// Public API request idempotency. Row-level security limits the scheduler_tenant role to app.tenant_id.
model ApiRequest {
  tenantId       String
  requestId      String
  operation      String
  requestSha256  String
  state          String
  ownerToken     String
  leaseExpiresAt DateTime          @db.Timestamptz(6)
  responseStatus Int?
  responseJson   Json?
  createdAt      DateTime          @default(now()) @db.Timestamptz(6)
  completedAt    DateTime?         @db.Timestamptz(6)
  tenant         Tenant            @relation(fields: [tenantId], references: [id], onUpdate: Cascade, onDelete: Restrict)
  proposal       ApiDailyProposal?
  receipt        ApiCommitReceipt?
  offerSet       ApiBookingOfferSet?
  bookingReceipt ApiBookingReceipt?
  @@id([tenantId, requestId])
  @@map("api_request")
}

/// A daily proposal served by the public API. No master data: only host IDs and the proposal body.
model ApiDailyProposal {
  tenantId        String
  id              String
  requestId       String
  metroId         String
  timeZone        String
  serviceDate     DateTime                   @db.Date
  inputRevision   String
  routingIdentity String
  status          String
  proposalJson    Json
  createdAt       DateTime                   @default(now()) @db.Timestamptz(6)
  committedAt     DateTime?                  @db.Timestamptz(6)
  request         ApiRequest                 @relation(fields: [tenantId, requestId], references: [tenantId, requestId], onDelete: Restrict, onUpdate: NoAction)
  technicianDays  ApiProposalTechnicianDay[]
  receipt         ApiCommitReceipt?
  @@id([tenantId, id])
  @@unique([tenantId, requestId])
  @@index([tenantId, metroId, serviceDate], map: "api_daily_proposal_day")
  @@map("api_daily_proposal")
}

/// Host lastModified per technician-day a proposal covers, as canonical ISO-8601 instant text.
model ApiProposalTechnicianDay {
  tenantId     String
  proposalId   String
  technicianId String
  serviceDate  DateTime         @db.Date
  lastModified String
  proposal     ApiDailyProposal @relation(fields: [tenantId, proposalId], references: [tenantId, id], onDelete: Cascade, onUpdate: NoAction)
  @@id([tenantId, proposalId, technicianId, serviceDate])
  @@map("api_proposal_technician_day")
}

/// The one commit of a daily proposal: the assignments the host was told to write.
model ApiCommitReceipt {
  tenantId    String
  id          String
  proposalId  String
  requestId   String
  receiptJson Json
  createdAt   DateTime         @default(now()) @db.Timestamptz(6)
  proposal    ApiDailyProposal @relation(fields: [tenantId, proposalId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction)
  request     ApiRequest       @relation(fields: [tenantId, requestId], references: [tenantId, requestId], onDelete: Restrict, onUpdate: NoAction)
  @@id([tenantId, id])
  @@unique([tenantId, proposalId])
  @@unique([tenantId, requestId])
  @@map("api_commit_receipt")
}

/// One metro-day's common booking arrangement and active holds for the public API, as validated JSON.
model ApiBookingDay {
  tenantId    String
  metroId     String
  serviceDate DateTime @db.Date
  version     Int
  stateJson   Json?
  updatedAt   DateTime @default(now()) @db.Timestamptz(6)
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onUpdate: Cascade, onDelete: Restrict)
  @@id([tenantId, metroId, serviceDate])
  @@map("api_booking_day")
}

/// The offers one booking search returned.
model ApiBookingOfferSet {
  tenantId     String
  id           String
  requestId    String
  jobId        String
  metroId      String
  expiresAt    DateTime          @db.Timestamptz(6)
  status       String
  offerSetJson Json
  createdAt    DateTime          @default(now()) @db.Timestamptz(6)
  request      ApiRequest        @relation(fields: [tenantId, requestId], references: [tenantId, requestId], onDelete: Restrict, onUpdate: NoAction)
  offers       ApiBookingOffer[]
  @@id([tenantId, id])
  @@unique([tenantId, requestId])
  @@index([tenantId, jobId], map: "api_booking_offer_set_job")
  @@map("api_booking_offer_set")
}

/// One offer and its hold.
model ApiBookingOffer {
  tenantId     String
  id           String
  offerSetId   String
  holdId       String
  serviceDate  DateTime           @db.Date
  technicianId String
  windowStart  DateTime           @db.Timestamptz(6)
  windowEnd    DateTime           @db.Timestamptz(6)
  status       String
  offerSet     ApiBookingOfferSet @relation(fields: [tenantId, offerSetId], references: [tenantId, id], onDelete: Cascade, onUpdate: NoAction)
  receipt      ApiBookingReceipt?
  @@id([tenantId, id])
  @@unique([tenantId, holdId])
  @@index([tenantId, offerSetId], map: "api_booking_offer_set_member")
  @@map("api_booking_offer")
}

/// The one confirm of a booking hold: the appointments the host was told to write.
model ApiBookingReceipt {
  tenantId    String
  id          String
  offerId     String
  requestId   String
  receiptJson Json
  createdAt   DateTime        @default(now()) @db.Timestamptz(6)
  offer       ApiBookingOffer @relation(fields: [tenantId, offerId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction)
  request     ApiRequest      @relation(fields: [tenantId, requestId], references: [tenantId, requestId], onDelete: Restrict, onUpdate: NoAction)
  @@id([tenantId, id])
  @@unique([tenantId, offerId])
  @@unique([tenantId, requestId])
  @@map("api_booking_receipt")
}

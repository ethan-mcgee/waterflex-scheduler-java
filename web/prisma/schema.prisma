// Prisma owns all migrations. The Java scheduler reads these tables via JDBC.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Reference / org data
// ---------------------------------------------------------------------------

model Metro {
  id              String   @id @default(cuid())
  name            String
  timezone        String // IANA tz, e.g. "America/Chicago"
  stateCode       String? // two-letter state code for bounded local geocoder extracts
  serviceRadiusMi Float    @default(65) // customer coverage radius from the nearest metro depot
  createdAt       DateTime @default(now())

  depots           Depot[]
  optimizationRuns OptimizationRun[]
  reservationArrangements ReservationArrangement[]

  @@map("metro")
}

model Depot {
  id        String   @id @default(cuid())
  metroId   String
  metro     Metro    @relation(fields: [metroId], references: [id])
  name      String
  lat       Float
  lng       Float
  addressLine1 String?
  addressCity String?
  addressState String?
  addressPostalCode String?
  geocodeLat Float?
  geocodeLng Float?
  geocodePrecision String?
  pinConfirmedAt DateTime?
  createdAt DateTime @default(now())

  dealershipId String
  dealership Dealership @relation(fields: [dealershipId], references: [id])
  endpointPolicies DepotEndpointPolicy[]
  assignments TechnicianDepotAssignment[]

  @@index([dealershipId])

  @@map("depot")
}

enum RouteAnchor {
  HOME
  DEPOT
}

model DepotEndpointPolicy {
  depotId String
  depot Depot @relation(fields: [depotId], references: [id], onDelete: Cascade)
  effectiveDate DateTime
  departure RouteAnchor
  returnTo RouteAnchor

  @@id([depotId, effectiveDate])
  @@map("depot_endpoint_policy")
}

model Dealership {
  id String @id @default(cuid())
  name String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  depots Depot[]

  @@map("dealership")
}

model Technician {
  id                 String      @id @default(cuid())
  name               String
  email              String?
  phone              String?
  bio                String?
  color              String
  homeAddressLine1   String?
  homeAddressCity    String?
  homeAddressState   String?
  homeAddressPostalCode String?
  homeLat            Float
  homeLng            Float
  homePinProvenance  String? // GEOCODER_HOUSE | MANUALLY_CONFIRMED; null for legacy homes
  shiftStartMin      Int // minutes from local midnight, e.g. 480 = 8:00am
  shiftEndMin        Int
  maxDailyMinutes    Int         @default(540)
  maxOvertimeMinutes Int         @default(60)
  active             Boolean     @default(true)
  externalId         String?     @unique // integration seam
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  appointments Appointment[]
  slotHolds    SlotHold[]
  scheduleDays ScheduleDay[]
  qualifications TechnicianQualification[]
  shiftOverrides TechnicianShiftOverride[]
  availabilityVersions TechnicianAvailabilityVersion[]
  timeOffRequests TimeOffRequest[]
  depotAssignments TechnicianDepotAssignment[]
  reservationDependencies ReservationDependency[]

  @@index([active])
  @@map("technician")
}

model TechnicianDepotAssignment {
  technicianId String
  technician Technician @relation(fields: [technicianId], references: [id], onDelete: Cascade)
  effectiveDate DateTime
  depotId String
  depot Depot @relation(fields: [depotId], references: [id])

  @@id([technicianId, effectiveDate])
  @@index([depotId, effectiveDate])
  @@map("technician_depot_assignment")
}

model TechnicianAvailabilityVersion {
  id String @id @default(cuid())
  technicianId String
  technician Technician @relation(fields: [technicianId], references: [id], onDelete: Cascade)
  effectiveDate DateTime
  days TechnicianAvailabilityDay[]

  @@unique([technicianId, effectiveDate])
  @@map("technician_availability_version")
}

model TechnicianAvailabilityDay {
  versionId String
  version TechnicianAvailabilityVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  dayOfWeek Int
  available Boolean
  shiftStartMin Int?
  shiftEndMin Int?

  @@id([versionId, dayOfWeek])
  @@map("technician_availability_day")
}

// ---------------------------------------------------------------------------
// Catalog
// ---------------------------------------------------------------------------

model ServiceCatalog {
  id             String   @id @default(cuid())
  code           String   @unique
  name           String // customer-facing dropdown label
  description    String?
  estDurationMin Int
  bufferPct      Float    @default(0.15) // confidence buffer, e.g. 0.15 = +15%
  startsAtDepot  Boolean  @default(false) // needs parts pickup before first stop
  active         Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  jobs Job[]
  qualifications TechnicianQualification[]

  reservationDependencies ReservationDependency[]

  @@map("service_catalog")
}

// ---------------------------------------------------------------------------
// Customers / jobs / appointments
// ---------------------------------------------------------------------------

model Customer {
  id         String   @id @default(cuid())
  firstName  String
  lastName   String
  email      String
  phone      String
  externalId String?  @unique
  createdAt  DateTime @default(now())

  addresses Address[]
  jobs      Job[]

  @@map("customer")
}

model Address {
  id               String    @id @default(cuid())
  customerId       String
  customer         Customer  @relation(fields: [customerId], references: [id])
  line1            String
  line2            String?
  city             String
  state            String
  postalCode       String
  lat              Float?
  lng              Float?
  geocodePrecision String? // ROOFTOP | RANGE_INTERPOLATED | GEOMETRIC_CENTER | APPROXIMATE | SYNTHETIC | MANUALLY_CONFIRMED
  geocodedAt       DateTime?
  pinConfirmedAt  DateTime?
  createdAt        DateTime  @default(now())

  jobs Job[]

  @@map("address")
}

enum JobStatus {
  PENDING // slot generation in progress / not yet booked
  SCHEDULED
  COMPLETED
  CANCELLED
}

model Job {
  id               String         @id @default(cuid())
  customerId       String
  customer         Customer       @relation(fields: [customerId], references: [id])
  addressId        String
  address          Address        @relation(fields: [addressId], references: [id])
  serviceId        String
  service          ServiceCatalog @relation(fields: [serviceId], references: [id])
  durationMin      Int // snapshot of service.estDurationMin * (1 + bufferPct) at booking time
  status           JobStatus      @default(PENDING)
  priority         Int            @default(0)
  externalId       String?        @unique
  bookingRequestId String?        @unique // client retry key for the slot-search attempt
  bookingRequestFingerprint String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  appointment          Appointment?
  slotHolds            SlotHold[]
  bookingOptimizations BookingOptimization[]
  bookingOffers BookingOffer[]
  offerSets BookingOfferSet[]
  searchRequests BookingSearchRequest[]
  manualFollowUpStatus String?
  manualFollowUpReason String?

  @@map("job")
}

model Appointment {
  id           String     @id @default(cuid())
  jobId        String     @unique
  job          Job        @relation(fields: [jobId], references: [id])
  technicianId String
  technician   Technician @relation(fields: [technicianId], references: [id])

  serviceDate DateTime // date-only, stored at midnight UTC of the metro's local day
  windowStart DateTime // customer promise — must not move without contact
  windowEnd   DateTime // customer promise — must not move without contact

  plannedStart DateTime // internal — freely re-orderable by the optimizer
  plannedEnd   DateTime
  sequence     Int // internal position in the technician's route for serviceDate

  externalId String?  @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  cancelledAt DateTime?
  cancellationReason String?

  @@index([technicianId, serviceDate])
  @@map("appointment")
}

// ---------------------------------------------------------------------------
// Booking concurrency
// ---------------------------------------------------------------------------

model ScheduleDay {
  id           String     @id @default(cuid())
  technicianId String
  technician   Technician @relation(fields: [technicianId], references: [id])
  serviceDate  DateTime
  version      Int        @default(0) // bumped on every committed change; the lock row
  routeTiming  Json?      // independently validated current segment timing at the recorded version

  @@unique([technicianId, serviceDate])
  @@map("schedule_day")
}

model SlotHold {
  id                    String               @id @default(cuid())
  offerToken            String // groups the 3-4 offers shown together; confirming one releases siblings
  jobId                 String // the job this hold would become an Appointment for, if confirmed
  job                   Job                  @relation(fields: [jobId], references: [id])
  technicianId          String
  technician            Technician           @relation(fields: [technicianId], references: [id])
  serviceDate           DateTime
  windowStart           DateTime // customer-facing promise, copied onto Appointment on confirm
  windowEnd             DateTime
  plannedStart          DateTime // internal arrival estimate at offer time; re-validated on confirm
  plannedEnd            DateTime
  insertPosition        Int // position among the tech's existing stops at offer time; re-validated on confirm
  locationLat           Float? // snapshot used to account for active holds during offer generation
  locationLng           Float?
  expiresAt             DateTime
  releasedAt            DateTime?
  createdAt             DateTime             @default(now())
  bookingOptimizationId String?
  bookingOptimization   BookingOptimization? @relation(fields: [bookingOptimizationId], references: [id])
  offerSetId String?
  offerSet BookingOfferSet? @relation(fields: [offerSetId], references: [id])
  reservationDependencies ReservationDependency[]

  @@index([technicianId, serviceDate])
  @@index([expiresAt])
  @@index([jobId])
  @@index([bookingOptimizationId])
  @@map("slot_hold")
}

model ReservationArrangement {
  id String @id @default(cuid())
  metroId String
  metro Metro @relation(fields: [metroId], references: [id])
  serviceDate DateTime
  version Int @default(0)
  state Json? // null means the lock row has not yet received a validated arrangement
  updatedAt DateTime @updatedAt
  dependencies ReservationDependency[]

  @@unique([metroId, serviceDate])
  @@map("reservation_arrangement")
}

model ReservationDependency {
  arrangementId String
  arrangement ReservationArrangement @relation(fields: [arrangementId], references: [id], onDelete: Cascade)
  holdId String
  hold SlotHold @relation(fields: [holdId], references: [id], onDelete: Cascade)
  technicianId String
  technician Technician @relation(fields: [technicianId], references: [id])
  serviceId String
  service ServiceCatalog @relation(fields: [serviceId], references: [id])
  serviceDate DateTime

  @@id([holdId, technicianId, serviceId])
  @@index([technicianId, serviceDate])
  @@index([arrangementId])
  @@map("reservation_dependency")
}

model BookingOffer {
  policyVersion String @default("zero-overtime-four-hour-v2")
  id String @id @default(cuid())
  jobId String
  job Job @relation(fields: [jobId], references: [id])
  serviceDate DateTime
  windowStart DateTime
  windowEnd DateTime
  expiresAt DateTime
  incrementalRegularMinutes Int?
  incrementalOvertimeMinutes Int?
  overtimeAuthorized Boolean @default(false)
  incrementalRoadMeters Int?
  incrementalCostDollars Float?
  createdAt DateTime @default(now())
  offerSetId String?
  offerSet BookingOfferSet? @relation(fields: [offerSetId], references: [id])

  @@index([jobId, expiresAt])
  @@map("booking_offer")
}

model BookingOfferSet {
  policyVersion String @default("zero-overtime-four-hour-v2")
  id String @id @default(cuid())
  jobId String
  job Job @relation(fields: [jobId], references: [id])
  expiresAt DateTime
  supersededAt DateTime?
  selectedOfferId String?
  searchDiagnostics Json?
  searchRequests BookingSearchRequest[]
  createdAt DateTime @default(now())
  offers BookingOffer[]
  holds SlotHold[]

  @@index([jobId, expiresAt])
  @@map("booking_offer_set")
}

model TimeOffRequest {
  id String @id @default(cuid())
  technicianId String
  technician Technician @relation(fields: [technicianId], references: [id])
  category String
  reason String
  status String @default("PENDING")
  createdAt DateTime @default(now())
  decidedAt DateTime?
  additionalOvertimeApproved Boolean @default(false)
  intervals TimeOffInterval[]
  report TimeOffReport?

  @@index([technicianId, status])
  @@map("time_off_request")
}

model TimeOffInterval {
  id String @id @default(cuid())
  requestId String
  request TimeOffRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  serviceDate DateTime
  startMin Int
  endMin Int

  @@index([serviceDate])
  @@map("time_off_interval")
}

model TimeOffReport {
  id String @id @default(cuid())
  requestId String @unique
  request TimeOffRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  status String @default("QUEUED")
  progress Int @default(0)
  data Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("time_off_report")
}

model TechnicianQualification {
  technicianId String
  technician Technician @relation(fields: [technicianId], references: [id])
  serviceId String
  service ServiceCatalog @relation(fields: [serviceId], references: [id])

  @@id([technicianId, serviceId])
  @@map("technician_qualification")
}

model TechnicianShiftOverride {
  id String @id @default(cuid())
  technicianId String
  technician Technician @relation(fields: [technicianId], references: [id])
  serviceDate DateTime
  available Boolean @default(true)
  shiftStartMin Int?
  shiftEndMin Int?

  @@unique([technicianId, serviceDate])
  @@map("technician_shift_override")
}

model RoadRouteCache {
  id String @id @default(cuid())
  originKey String
  destinationKey String
  profile String
  mapVersion String
  seconds Int?
  meters Int?
  routable Boolean
  fetchedAt DateTime @default(now())

  @@unique([originKey, destinationKey, profile, mapVersion])
  @@index([fetchedAt])
  @@map("road_route_cache")
}

model OmahaSetting {
  key String @id
  value Float
  updatedAt DateTime @updatedAt

  @@map("omaha_setting")
}

model BookingOptimization {
  id                   String     @id @default(cuid())
  jobId                String
  job                  Job        @relation(fields: [jobId], references: [id])
  offerToken           String     @unique
  algorithmVersion     String
  strategy             String
  candidateCount       Int
  qualifyingOfferCount Int
  returnedOffers       Json
  solverMs             Int        @default(0)
  fallbackStatus       String?
  travelWarnings       Json
  confirmedHoldId      String?
  createdAt            DateTime   @default(now()) @db.Timestamptz(6)
  slotHolds            SlotHold[]

  @@index([jobId, createdAt])
  @@map("booking_optimization")
}

model OptimizationRun {
  id                   String               @id @default(cuid())
  requestKey           String?              @unique
  metroId              String
  metro                Metro                @relation(fields: [metroId], references: [id])
  serviceDate          DateTime @db.Timestamptz(6)
  scheduleVersions     Json
  weights              Json
  solverStatus         String
  solveMs              Int
  routeSummaryBefore   Json
  routeSummaryAfter    Json
  warnings             Json
  proposedAssignments  Json
  baselineAssignments  Json                 @default("[]")
  endpointSnapshots    Json?
  policyAnalysis       Json?
  objectiveImprovement Int
  churnCost            Int
  status               String
  reason               String?
  createdAt            DateTime             @default(now()) @db.Timestamptz(6)
  appliedAt            DateTime? @db.Timestamptz(6)
  changes              OptimizationChange[]

  @@index([metroId, serviceDate, createdAt])
  @@map("optimization_run")
}

// Local sequential booking harness. Jobs use stable IDs derived from request IDs.
model BookingTestRun {
  id String @id
  config Json
  horizon Json
  status String @default("PAUSED")
  revision Int @default(0)
  error String?
  purgedAt DateTime?
  purgedCount Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  requests BookingTestRequest[]
  previews BookingTestPreview[]
  generation BookingTestGeneration?
  @@map("booking_test_run")
}

model BookingTestGeneration {
  runId String @id
  run BookingTestRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  acceptedInputs Json @default("[]")
  randomState BigInt
  roundRobinCursor Int @default(0)
  pendingCandidates Json?
  candidatesTried BigInt @default(0)
  batches BigInt @default(0)
  elapsedMs BigInt @default(0)
  consecutiveNoProgressBatches BigInt @default(0)
  completedAt DateTime?
  @@map("booking_test_generation")
}

model BookingTestRequest {
  id String @id
  runId String
  run BookingTestRun @relation(fields: [runId], references: [id])
  ordinal Int
  input Json
  status String @default("PENDING")
  offers Json @default("[]")
  selected Json?
  attempts Json @default("[]")
  appointmentId String?
  serviceDate String?
  error String?
  elapsedMs Int @default(0)
  startedAt DateTime?
  completedAt DateTime?
  @@unique([runId, ordinal])
  @@map("booking_test_request")
}

model BookingTestPreview {
  id String @id
  runId String
  run BookingTestRun @relation(fields: [runId], references: [id])
  serviceDate String
  optimizationId String?
  result Json?
  error String?
  @@unique([runId, serviceDate])
  @@map("booking_test_preview")
}

model OptimizationChange {
  id                    String          @id @default(cuid())
  runId                 String
  run                   OptimizationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  appointmentId         String
  fromTechnicianId      String
  toTechnicianId        String
  fromSequence          Int
  toSequence            Int
  fromPlannedArrivalMin Int
  toPlannedArrivalMin   Int

  @@index([runId])
  @@map("optimization_change")
}

// ---------------------------------------------------------------------------
// Travel time cache
// ---------------------------------------------------------------------------

enum TimeBucket {
  AM_PEAK
  MIDDAY
  PM_PEAK
}

enum DayType {
  WEEKDAY
  WEEKEND
}

model TravelTime {
  id            String     @id @default(cuid())
  originGeohash String // geohash precision 7 (~150m cells)
  destGeohash   String
  timeBucket    TimeBucket
  dayType       DayType
  seconds       Int
  meters        Int
  source        String     @default("google_distance_matrix") // or "haversine_fallback"
  fetchedAt     DateTime   @default(now())

  @@unique([originGeohash, destGeohash, timeBucket, dayType])
  @@index([fetchedAt])
  @@map("travel_time")
}

// ---------------------------------------------------------------------------
// Scoring config (ops-tunable, no deploy required)
// ---------------------------------------------------------------------------

model ScoringWeight {
  id        String   @id @default(cuid())
  key       String   @unique // "w_drive" | "w_days" | "w_util" | "w_window"
  value     Float
  updatedAt DateTime @updatedAt

  @@map("scoring_weight")
}

// ---------------------------------------------------------------------------
// Integration seam
// ---------------------------------------------------------------------------

model OutboundEvent {
  id          String    @id @default(cuid())
  aggregate   String // "job" | "appointment" | "customer" | "technician"
  aggregateId String
  eventType   String // "created" | "updated" | "cancelled"
  payload     Json
  createdAt   DateTime  @default(now())
  deliveredAt DateTime?

  @@index([deliveredAt])
  @@map("outbound_event")
}

model BookingSearchRequest {
  state String?
  refresh Boolean @default(false)
  owner String?
  leaseUntil DateTime?
  startedAt DateTime?
  finishedAt DateTime?
  stopReason String?
  queueMs BigInt?
  completedWork BigInt @default(0)
  phase String @default("QUEUED")
  id String @id
  jobId String
  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)
  deadlineAt DateTime
  cancelledAt DateTime?
  acknowledgedAt DateTime?
  offerSetId String?
  offerSet BookingOfferSet? @relation(fields: [offerSetId], references: [id], onDelete: SetNull)
  cleanedAt DateTime?
  createdAt DateTime @default(now())

  @@index([cancelledAt, cleanedAt], map: "booking_search_request_cleanup_idx")
  @@index([deadlineAt], map: "booking_search_request_deadline_idx")
  @@map("booking_search_request")
}

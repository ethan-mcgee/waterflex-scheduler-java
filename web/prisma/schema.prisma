// The portal's own database. The scheduler keeps its tables in its own database and is reached only through /api/v1.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Reference / org data
// ---------------------------------------------------------------------------

model Metro {
  id              String   @id @default(cuid())
  name            String
  timezone        String // IANA tz, e.g. "America/Chicago"
  stateCode       String? // two-letter state code for bounded local geocoder extracts
  serviceRadiusMi Float    @default(65) // customer coverage radius from the nearest metro depot
  createdAt       DateTime @default(now())

  depots           Depot[]
  apiOfferSets     PortalApiOfferSet[]
  apiDailyProposals PortalApiDailyProposal[]
  overnightDays PortalOvernightDay[]

  @@map("metro")
}

model Depot {
  id        String   @id @default(cuid())
  metroId   String
  metro     Metro    @relation(fields: [metroId], references: [id])
  name      String
  lat       Float
  lng       Float
  addressLine1 String?
  addressCity String?
  addressState String?
  addressPostalCode String?
  geocodeLat Float?
  geocodeLng Float?
  geocodePrecision String?
  pinConfirmedAt DateTime?
  createdAt DateTime @default(now())

  dealershipId String
  dealership Dealership @relation(fields: [dealershipId], references: [id])
  endpointPolicies DepotEndpointPolicy[]
  assignments TechnicianDepotAssignment[]

  @@index([dealershipId])

  @@map("depot")
}

enum RouteAnchor {
  HOME
  DEPOT
}

model DepotEndpointPolicy {
  depotId String
  depot Depot @relation(fields: [depotId], references: [id], onDelete: Cascade)
  effectiveDate DateTime
  departure RouteAnchor
  returnTo RouteAnchor

  @@id([depotId, effectiveDate])
  @@map("depot_endpoint_policy")
}

/// A client the portal schedules for, standing in for WaterFlex Software. Its API token is in the environment.
model Client {
  id          String       @id
  name        String
  createdAt   DateTime     @default(now()) @db.Timestamptz(6)
  dealerships Dealership[]
  technicians Technician[]
  customers   Customer[]
  solverSettings ClientSolverSettings?
  apiOfferSets   PortalApiOfferSet[]
  apiDailyProposals PortalApiDailyProposal[]
  overnightTimes ClientOvernightTime[]
  overnightRuns  PortalOvernightRun[]
  bookingTestRuns BookingTestRun[]

  @@map("client")
}

// A client's own booking and routing settings. No row means the client has not configured them yet.
model ClientSolverSettings {
  clientId               String   @id
  client                 Client   @relation(fields: [clientId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  // The scheduler's cost rate contract: at most 500 an hour and 25 a mile (CHECK constraints, spec 1.7.0).
  regularHourly          Decimal  @db.Decimal(14, 4)
  overtimeHourly         Decimal  @db.Decimal(14, 4)
  mileagePerMile         Decimal  @db.Decimal(14, 4)
  travelBufferPct        Decimal  @db.Decimal(6, 4)
  travelBufferMinutes    Int
  fairnessBudget         Decimal  @db.Decimal(6, 4)
  offerLimit             Int
  windowHours            Int
  // The fixed horizon's length, or the dynamic horizon's cap: 1 to 15 weekdays (CHECK constraint).
  bookingHorizonWeekdays Int
  // FIXED or DYNAMIC (CHECK constraint); read through clientSettings.ts, which validates it.
  horizonMode            String
  // 1 to 5 (CHECK constraint): weekdays a dynamic horizon books past the furthest booked-out weekday.
  horizonLeadWeekdays    Int
  // 50 to 100 (CHECK constraint): the route span share at which a weekday counts as booked out.
  horizonFullPercent     Int
  // TABU, TABU_KOPT or TABU_KOPT_SIZE_3 (CHECK constraint); read through clientSettings.ts, which validates it.
  dailySearch            String
  costSearchSeconds      Int
  fairnessSearchSeconds  Int
  // 1 to costSearchSeconds (CHECK constraint): a daily search also ends once its best plan has not improved for
  // this long. Null is the client's choice that every search spends its whole time.
  unimprovedSearchSeconds Int?
  // 1000 to 5000 (CHECK constraint): a booking search or confirm's deadline at the scheduler.
  bookingDeadlineMs      Int
  // 0 to 1000 (CHECK constraint): regular windows above which the booking refinement is kept short.
  regularWindowThreshold Int
  version                Int      @default(0)
  updatedAt              DateTime @default(now()) @db.Timestamptz(6)

  @@map("client_solver_settings")
}

model Dealership {
  id String @id @default(cuid())
  clientId String
  client Client @relation(fields: [clientId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  name String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  depots Depot[]

  @@index([clientId], map: "dealership_client")
  @@map("dealership")
}

model Technician {
  id                 String      @id @default(cuid())
  clientId           String
  client             Client      @relation(fields: [clientId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  name               String
  email              String?
  phone              String?
  bio                String?
  color              String
  homeAddressLine1   String?
  homeAddressCity    String?
  homeAddressState   String?
  homeAddressPostalCode String?
  homeLat            Float
  homeLng            Float
  homePinProvenance  String? // GEOCODER_HOUSE | MANUALLY_CONFIRMED; null for legacy homes
  shiftStartMin      Int // minutes from local midnight, e.g. 480 = 8:00am
  shiftEndMin        Int
  maxDailyMinutes    Int         @default(540)
  maxOvertimeMinutes Int         @default(60)
  active             Boolean     @default(true)
  factsChangedAt     DateTime    @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6) // set by database triggers
  externalId         String?     @unique // integration seam
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  appointments Appointment[]
  scheduleDays ScheduleDay[]
  dayChanges   TechnicianDayChange[]
  qualifications TechnicianQualification[]
  shiftOverrides TechnicianShiftOverride[]
  availabilityVersions TechnicianAvailabilityVersion[]
  timeOffRequests TimeOffRequest[]
  depotAssignments TechnicianDepotAssignment[]

  @@index([active])
  @@index([clientId], map: "technician_client")
  @@map("technician")
}

model TechnicianDepotAssignment {
  technicianId String
  technician Technician @relation(fields: [technicianId], references: [id], onDelete: Cascade)
  effectiveDate DateTime
  depotId String
  depot Depot @relation(fields: [depotId], references: [id])

  @@id([technicianId, effectiveDate])
  @@index([depotId, effectiveDate])
  @@map("technician_depot_assignment")
}

model TechnicianAvailabilityVersion {
  id String @id @default(cuid())
  technicianId String
  technician Technician @relation(fields: [technicianId], references: [id], onDelete: Cascade)
  effectiveDate DateTime
  days TechnicianAvailabilityDay[]

  @@unique([technicianId, effectiveDate])
  @@map("technician_availability_version")
}

model TechnicianAvailabilityDay {
  versionId String
  version TechnicianAvailabilityVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  dayOfWeek Int
  available Boolean
  shiftStartMin Int?
  shiftEndMin Int?

  @@id([versionId, dayOfWeek])
  @@map("technician_availability_day")
}

// ---------------------------------------------------------------------------
// Catalog
// ---------------------------------------------------------------------------

model ServiceCatalog {
  id             String   @id @default(cuid())
  code           String   @unique
  name           String // customer-facing dropdown label
  description    String?
  estDurationMin Int
  bufferPct      Float    @default(0.15) // confidence buffer, e.g. 0.15 = +15%
  active         Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  jobs Job[]
  qualifications TechnicianQualification[]


  @@map("service_catalog")
}

// ---------------------------------------------------------------------------
// Customers / jobs / appointments
// ---------------------------------------------------------------------------

model Customer {
  id         String   @id @default(cuid())
  clientId   String
  client     Client   @relation(fields: [clientId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  firstName  String
  lastName   String
  email      String
  phone      String
  externalId String?  @unique
  createdAt  DateTime @default(now())

  addresses Address[]
  jobs      Job[]

  @@index([clientId], map: "customer_client")
  @@map("customer")
}

model Address {
  id               String    @id @default(cuid())
  customerId       String
  customer         Customer  @relation(fields: [customerId], references: [id])
  line1            String
  line2            String?
  city             String
  state            String
  postalCode       String
  lat              Float?
  lng              Float?
  geocodePrecision String? // ROOFTOP | RANGE_INTERPOLATED | GEOMETRIC_CENTER | APPROXIMATE | SYNTHETIC | MANUALLY_CONFIRMED
  geocodedAt       DateTime?
  pinConfirmedAt  DateTime?
  createdAt        DateTime  @default(now())

  jobs Job[]

  @@map("address")
}

enum JobStatus {
  PENDING // slot generation in progress / not yet booked
  SCHEDULED
  COMPLETED
  CANCELLED
}

model Job {
  id               String         @id @default(cuid())
  customerId       String
  customer         Customer       @relation(fields: [customerId], references: [id])
  addressId        String
  address          Address        @relation(fields: [addressId], references: [id])
  serviceId        String
  service          ServiceCatalog @relation(fields: [serviceId], references: [id])
  durationMin      Int // snapshot of service.estDurationMin * (1 + bufferPct) at booking time
  status           JobStatus      @default(PENDING)
  externalId       String?        @unique
  bookingRequestId String?        @unique // client retry key for the slot-search attempt
  bookingRequestFingerprint String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  appointment          Appointment?
  apiOfferSets   PortalApiOfferSet[]
  manualFollowUpStatus String?
  manualFollowUpReason String?

  @@map("job")
}

model Appointment {
  id           String     @id @default(cuid())
  jobId        String     @unique
  job          Job        @relation(fields: [jobId], references: [id])
  technicianId String
  technician   Technician @relation(fields: [technicianId], references: [id])

  serviceDate DateTime // date-only, stored at midnight UTC of the metro's local day
  windowStart DateTime // customer promise: must not move without contact
  windowEnd   DateTime // customer promise: must not move without contact

  plannedStart DateTime // internal: freely re-orderable by the optimizer
  plannedEnd   DateTime
  sequence     Int // internal position in the technician's route for serviceDate

  externalId String?  @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  cancelledAt DateTime?
  cancellationReason String?

  @@index([technicianId, serviceDate])
  @@map("appointment")
}

// ---------------------------------------------------------------------------
// Booking concurrency
// ---------------------------------------------------------------------------

model ScheduleDay {
  id           String     @id @default(cuid())
  technicianId String
  technician   Technician @relation(fields: [technicianId], references: [id])
  serviceDate  DateTime
  version      Int        @default(0) // bumped on every committed change; the lock row

  @@unique([technicianId, serviceDate])
  @@map("schedule_day")
}

// When a technician-day's own facts last changed (appointments, date exception, time off). Written only by database
// triggers; no row means never. The public API lastModified is the later of this and technician.factsChangedAt.
model TechnicianDayChange {
  technicianId String
  technician   Technician @relation(fields: [technicianId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  serviceDate  DateTime
  changedAt    DateTime   @db.Timestamptz(6)

  @@id([technicianId, serviceDate])
  @@map("technician_day_change")
}

// Offers the public scheduling API returned for a job, kept by the portal acting as the host.
model PortalApiOfferSet {
  id              String           @id
  clientId        String
  client          Client           @relation(fields: [clientId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  jobId           String
  job             Job              @relation(fields: [jobId], references: [id], onDelete: Cascade)
  metroId         String
  metro           Metro            @relation(fields: [metroId], references: [id], onDelete: Restrict)
  requestId       String           @unique @db.Uuid
  expiresAt       DateTime         @db.Timestamptz(6)
  searchComplete  Boolean
  holdId          String?
  selectedOfferId String?
  selectedOffer   PortalApiOffer?  @relation("SelectedOffer", fields: [selectedOfferId], references: [id], onDelete: Restrict)
  receiptId       String?          @unique
  endedAt         DateTime?        @db.Timestamptz(6)
  createdAt       DateTime         @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)
  offers          PortalApiOffer[] @relation("SetOffers")

  @@index([jobId, createdAt], map: "portal_api_offer_set_job")
  @@map("portal_api_offer_set")
}

model PortalApiOffer {
  id          String              @id
  offerSetId  String
  offerSet    PortalApiOfferSet   @relation("SetOffers", fields: [offerSetId], references: [id], onDelete: Cascade)
  serviceDate DateTime            @db.Date
  windowStart DateTime            @db.Timestamptz(6)
  windowEnd   DateTime            @db.Timestamptz(6)
  selectedBy  PortalApiOfferSet[] @relation("SelectedOffer")

  @@index([offerSetId], map: "portal_api_offer_set_offers")
  @@map("portal_api_offer")
}

model PortalApiDailyProposal {
  id              String    @id
  clientId        String
  client          Client    @relation(fields: [clientId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  metroId         String
  metro           Metro     @relation(fields: [metroId], references: [id], onDelete: Restrict)
  serviceDate     DateTime  @db.Date
  requestId       String    @unique @db.Uuid
  kind            String
  timeOffRequestId String?
  timeOffRequest  TimeOffRequest? @relation(fields: [timeOffRequestId], references: [id], onDelete: Cascade)
  decision        String
  proposal        Json
  technicianDays  Json
  baseline        Json
  commitRequestId String?   @unique @db.Uuid
  receiptId       String?   @unique
  committedAt     DateTime? @db.Timestamptz(6)
  commitRefusal   String?
  createdAt       DateTime  @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)
  overnightDay    PortalOvernightDay?

  @@index([clientId, metroId, serviceDate, createdAt], map: "portal_api_daily_proposal_day")
  @@index([timeOffRequestId], map: "portal_api_daily_proposal_time_off")
  @@map("portal_api_daily_proposal")
}

model TimeOffRequest {
  id String @id @default(cuid())
  technicianId String
  technician Technician @relation(fields: [technicianId], references: [id])
  category String
  reason String
  status String @default("PENDING")
  createdAt DateTime @default(now())
  decidedAt DateTime?
  intervals TimeOffInterval[]
  report TimeOffReport?
  apiRepairProposals PortalApiDailyProposal[]

  @@index([technicianId, status])
  @@map("time_off_request")
}

model TimeOffInterval {
  id String @id @default(cuid())
  requestId String
  request TimeOffRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  serviceDate DateTime
  startMin Int
  endMin Int

  @@index([serviceDate])
  @@map("time_off_interval")
}

model TimeOffReport {
  id String @id @default(cuid())
  requestId String @unique
  request TimeOffRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  status String @default("QUEUED")
  progress Int @default(0)
  data Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("time_off_report")
}

model TechnicianQualification {
  technicianId String
  technician Technician @relation(fields: [technicianId], references: [id])
  serviceId String
  service ServiceCatalog @relation(fields: [serviceId], references: [id])

  @@id([technicianId, serviceId])
  @@map("technician_qualification")
}

model TechnicianShiftOverride {
  id String @id @default(cuid())
  technicianId String
  technician Technician @relation(fields: [technicianId], references: [id])
  serviceDate DateTime
  available Boolean @default(true)
  shiftStartMin Int?
  shiftEndMin Int?

  @@unique([technicianId, serviceDate])
  @@map("technician_shift_override")
}

// Local sequential booking harness. Jobs use stable IDs derived from request IDs.
model BookingTestRun {
  id String @id
  /// The client a public-API run books for; null for runs that book through the scheduler's portal endpoints.
  clientId String?
  client Client? @relation(fields: [clientId], references: [id], onDelete: Restrict)
  config Json
  horizon Json
  status String @default("PAUSED")
  revision Int @default(0)
  error String?
  purgedAt DateTime?
  purgedCount Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  requests BookingTestRequest[]
  previews BookingTestPreview[]
  generation BookingTestGeneration?
  @@map("booking_test_run")
}

model BookingTestGeneration {
  runId String @id
  run BookingTestRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  acceptedInputs Json @default("[]")
  randomState BigInt
  roundRobinCursor Int @default(0)
  pendingCandidates Json?
  candidatesTried BigInt @default(0)
  batches BigInt @default(0)
  elapsedMs BigInt @default(0)
  consecutiveNoProgressBatches BigInt @default(0)
  completedAt DateTime?
  @@map("booking_test_generation")
}

model BookingTestRequest {
  id String @id
  runId String
  run BookingTestRun @relation(fields: [runId], references: [id])
  ordinal Int
  input Json
  status String @default("PENDING")
  offers Json @default("[]")
  selected Json?
  attempts Json @default("[]")
  appointmentId String?
  serviceDate String?
  error String?
  elapsedMs Int @default(0)
  startedAt DateTime?
  completedAt DateTime?
  @@unique([runId, ordinal])
  @@map("booking_test_request")
}

model BookingTestPreview {
  id String @id
  runId String
  run BookingTestRun @relation(fields: [runId], references: [id])
  serviceDate String
  optimizationId String?
  result Json?
  error String?
  @@unique([runId, serviceDate])
  @@map("booking_test_preview")
}

// ---------------------------------------------------------------------------
// Travel time cache
// ---------------------------------------------------------------------------

// ---------------------------------------------------------------------------
// Scoring config (ops-tunable, no deploy required)
// ---------------------------------------------------------------------------

// ---------------------------------------------------------------------------
// Integration seam
// ---------------------------------------------------------------------------

// A client's scheduled overnight run times, as minutes after local midnight. No rows means manual runs only.
model ClientOvernightTime {
  clientId    String
  client      Client @relation(fields: [clientId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  localMinute Int

  @@id([clientId, localMinute])
  @@map("client_overnight_time")
}

// One overnight optimization run for a client; the table is the run queue. Partial unique indexes (one run per
// scheduled time, one queued or running run per client) are in the migration.
model PortalOvernightRun {
  id           String               @id @db.Uuid
  clientId     String
  client       Client               @relation(fields: [clientId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  trigger      String
  scheduledFor DateTime?            @db.Timestamptz(6)
  status       String
  createdAt    DateTime             @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)
  startedAt    DateTime?            @db.Timestamptz(6)
  heartbeatAt  DateTime?            @db.Timestamptz(6)
  finishedAt   DateTime?            @db.Timestamptz(6)
  days         PortalOvernightDay[]

  @@index([clientId, createdAt], map: "portal_overnight_run_client")
  @@map("portal_overnight_run")
}

// What an overnight run did for one metro day: the proposal it kept for a dispatcher, or why it kept none.
model PortalOvernightDay {
  runId       String                  @db.Uuid
  run         PortalOvernightRun      @relation(fields: [runId], references: [id], onDelete: Cascade)
  metroId     String
  metro       Metro                   @relation(fields: [metroId], references: [id], onDelete: Restrict)
  serviceDate DateTime                @db.Date
  outcome     String
  proposalId  String?                 @unique
  proposal    PortalApiDailyProposal? @relation(fields: [proposalId], references: [id], onDelete: Restrict)
  message     String?
  finishedAt  DateTime                @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)

  @@id([runId, metroId, serviceDate])
  @@map("portal_overnight_day")
}
